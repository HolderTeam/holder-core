@PACKAGE_INIT@

set_and_check(holder_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/holder")
set_and_check(holder_SCHEMA_FILE "${holder_DATA_DIR}/schema/schema.sql")
set_and_check(holder_WELCOME_FILE "${holder_DATA_DIR}/resources/WELCOME.md")

include(CMakeFindDependencyMacro)

find_dependency(OpenSSL)
find_dependency(Threads)
find_dependency(nlohmann_json 3.6.0)
find_dependency(yaml-cpp)
find_dependency(spdlog)

if(WIN32 OR ANDROID)
  find_dependency(unofficial-sodium CONFIG)
  find_dependency(md4c CONFIG)

  find_package(unofficial-sqlite3 CONFIG QUIET)
  if(NOT TARGET unofficial::sqlite3::sqlite3)
    find_dependency(SQLite3)
  endif()

  find_package(unofficial-libgit2 CONFIG QUIET)
  find_package(libgit2 CONFIG QUIET)
else()
  find_dependency(PkgConfig)
  pkg_check_modules(SQLITE3 REQUIRED IMPORTED_TARGET sqlite3)
  pkg_check_modules(SODIUM REQUIRED IMPORTED_TARGET libsodium)
  pkg_check_modules(LIBGIT2 REQUIRED IMPORTED_TARGET libgit2)
  pkg_check_modules(MD4C REQUIRED IMPORTED_TARGET md4c)
  if(NOT APPLE)
    pkg_check_modules(LIBSECRET IMPORTED_TARGET libsecret-1)
    if(@LIBSECRET_FOUND@ AND NOT LIBSECRET_FOUND)
      message(FATAL_ERROR "This libholder SDK was built with libsecret; install libsecret-1 development files")
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/holderTargets.cmake")
