#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake+ninja --builddirectory=build -- \
		-DBUILD_TESTING=OFF \
		-DHOLDER_CORE_BUILD_SHARED=ON \
		-DHOLDER_CORE_SDK=OFF \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo

override_dh_auto_test:
	# Core tests run in the normal CI workflow; packaging is checked separately.

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build
